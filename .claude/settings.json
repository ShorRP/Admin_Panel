{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-comments-before-pr.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-after-edit.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agent-workflow": {
      "source": {
        "source": "github",
        "repo": "PothieuG/agent-workflow"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "agent-workflow@agent-workflow": true
  },
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "600000"
  }
}
